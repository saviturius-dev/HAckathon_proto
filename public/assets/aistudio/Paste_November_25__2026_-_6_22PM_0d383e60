        sampled_values = {}
        for cat, params in self.category_posteriors.items():
            # Draw sample from Beta distribution
            sample = np.random.beta(params["alpha"], params["beta"])
            sampled_values[cat] = sample
            
        selected_category = max(sampled_values, key=sampled_values.get)
        return selected_category

    def sample_tier_weight(self, tier: int) -> float:
        """Samples the conversion probability expectation for a given tier."""
        params = self.tier_posteriors[tier]
        return float(np.random.beta(params["alpha"], params["beta"]))

    def select_next_question(self, available_questions: List[Dict[str, Any]], current_tier: int) -> Dict[str, Any]:
        """
        Selects the optimal question for the current tier by filtering available questions
        and prioritizing categories with higher Thompson Sampling scores.
        """
        tier_questions = [q for q in available_questions if q["tier"] == current_tier]
        if not tier_questions:
            raise ValueError(f"No available questions found for Tier {current_tier}")
            
        # Sample winning category
        winning_category = self.sample_category()
        
        # Filter questions matching the winning category
        matching_questions = [q for q in tier_questions if q["category"] == winning_category]
        
        # Fallback if no questions exist for that specific category in this tier
        if not matching_questions:
            return random.choice(tier_questions)
            
        return random.choice(matching_questions)

    def log_session_and_update_policy(self, session_id: str, served_questions: List[Dict[str, Any]], final_choice: str):
        """
        Core RL Learning Loop:
        1. Evaluates reward: R = 1.0 if final_choice == 'AI_PC' else 0.0
        2. Identifies categories and tiers served in the session.
        3. Updates Beta posteriors (alpha += R, beta += (1 - R)).
        """
        reward = 1.0 if final_choice == "AI_PC" else 0.0
        
        served_categories = list(set(q["category"] for q in served_questions))
        served_tiers = list(set(q["tier"] for q in served_questions))
        
        # Update Category Posteriors
        for cat in served_categories:
            self.category_posteriors[cat]["impressions"] += 1
            if reward == 1.0:
                self.category_posteriors[cat]["alpha"] += 1.0
                self.category_posteriors[cat]["conversions"] += 1
            else:
                self.category_posteriors[cat]["beta"] += 1.0

        # Update Tier Posteriors
        for tier in served_tiers:
            self.tier_posteriors[tier]["impressions"] += 1
            if reward == 1.0:
                self.tier_posteriors[tier]["alpha"] += 1.0
                self.tier_posteriors[tier]["conversions"] += 1
            else:
                self.tier_posteriors[tier]["beta"] += 1.0

        # Store Session Log
        log_entry = {
            "session_id": session_id,
            "served_categories": served_categories,
            "served_tiers": served_tiers,
            "final_choice": final_choice,
            "reward": reward
        }
        self.session_logs.append(log_entry)
        logging.info(f"Session {session_id} logged. Choice: {final_choice} | Reward: {reward}")

    def export_policy_state(self) -> Dict[str, Any]:
        """Returns the current expected conversion values and posterior distributions."""
        policy_summary = {"categories": {}, "tiers": {}}
        
        for cat, params in self.category_posteriors.items():
            expected_conversion = params["alpha"] / (params["alpha"] + params["beta"])
            policy_summary["categories"][cat] = {
                "expected_conversion_rate": round(expected_conversion, 4),
                "alpha": params["alpha"],
                "beta": params["beta"],
                "impressions": params["impressions"],
                "conversions": params["conversions"]
            }
            
        for tier, params in self.tier_posteriors.items():
            expected_conversion = params["alpha"] / (params["alpha"] + params["beta"])
            policy_summary["tiers"][tier] = {
                "expected_conversion_rate": round(expected_conversion, 4),
                "alpha": params["alpha"],
                "beta": params["beta"],
                "impressions": params["impressions"],
                "conversions": params["conversions"]
            }
            
        return policy_summary


